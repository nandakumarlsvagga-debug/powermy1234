# POWERLVL — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to git.

# ─────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose to client-side code)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (SERVER ONLY — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Postgres connection string — use Supabase connection pooler (Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────
# AWS (Bedrock Nova Lite + Rekognition)
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Must be a region where Bedrock Nova Lite is available (us-east-1 recommended)
AWS_REGION=us-east-1

# ─────────────────────────────────────────
# App security
# ─────────────────────────────────────────
# 32+ random bytes for HMAC signing the plvl_anon cookie
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLVL_ANON_COOKIE_SECRET=generate-32-random-bytes-here

# Secret for authenticating internal cron job endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_JOB_SECRET=generate-32-random-bytes-here

# Public base URL of the deployed app (no trailing slash)
APP_BASE_URL=https://powerlvl.app

# ─────────────────────────────────────────
# Web client (Vite build-time env vars — must start with VITE_)
# ─────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_APP_BASE_URL=https://powerlvl.app
